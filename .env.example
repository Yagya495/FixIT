# ---- Core ----
DEMO_MODE=true
DATA_BACKEND=local            # local | databricks
SHOW_BBOXES=false

# ---- Databricks (needed when DATA_BACKEND=databricks or for live AI calls) ----
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=             # or use a CLI profile via DATABRICKS_CONFIG_PROFILE
DATABRICKS_CONFIG_PROFILE=
DATABRICKS_WAREHOUSE_ID=
FIXIT_CATALOG=fixit

# ---- Model serving endpoints (verify with notebooks/00_smoke_tests.py) ----
CHAT_ENDPOINT=databricks-llama-4-maverick
VISION_ENDPOINT=databricks-llama-4-maverick
EMBEDDING_ENDPOINT=databricks-gte-large-en
VECTOR_SEARCH_ENDPOINT=fixit-vs
VECTOR_INDEX=fixit.silver.code_chunks_index
GENIE_SPACE_ID=

# ---- P1 real calls (sidecar) ----
CALLS_ENABLED=false
CALL_ALLOWLIST=               # comma-separated E.164 numbers of consenting teammates/judges only
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Retell (explicitly authorized test calls only; separate from simulated calls) ----
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=          # Retell-owned/imported number, E.164
RETELL_OPERATOR_TOKEN=       # separate random secret, at least 32 characters; never the API key
# CALLS_ENABLED and CALL_ALLOWLIST above also gate Retell. See docs/RETELL_SETUP.md.
