{
  "question": "Which management companies improved their fix times the most?",
  "text": "Northstar Property Management showed the greatest improvement in fix times, reducing their median days to fix by 3.5 days (from 13.6 to 10.1 days). Bluff Property Management also improved, with a reduction of 1.2 days (from 13.4 to 12.2 days). All other management companies in the sample had no change in their fix times.",
  "sql": "WITH fix_times AS (\n  SELECT \n    o.management_company,\n    ls.owner_id,\n    ls.median_days_to_fix,\n    ls.grade,\n    ls.score\n  FROM `fixit`.`gold`.`landlord_scores` ls\n  JOIN `fixit`.`gold`.`owners` o ON ls.owner_id = o.owner_id\n  WHERE ls.median_days_to_fix IS NOT NULL AND o.management_company IS NOT NULL\n)\n, ranked_scores AS (\n  SELECT \n    management_company,\n    median_days_to_fix,\n    grade,\n    score,\n    ROW_NUMBER() OVER (PARTITION BY management_company ORDER BY score ASC) AS rn_old,\n    ROW_NUMBER() OVER (PARTITION BY management_company ORDER BY score DESC) AS rn_new\n  FROM fix_times\n)\n, old_new_fix_times AS (\n  SELECT \n    management_company,\n    MAX(CASE WHEN rn_old = 1 THEN median_days_to_fix END) AS old_fix_time,\n    MAX(CASE WHEN rn_new = 1 THEN median_days_to_fix END) AS new_fix_time\n  FROM ranked_scores\n  GROUP BY management_company\n)\nSELECT \n  management_company,\n  old_fix_time,\n  new_fix_time,\n  old_fix_time - new_fix_time AS improvement\nFROM old_new_fix_times\nWHERE old_fix_time IS NOT NULL AND new_fix_time IS NOT NULL\nORDER BY improvement DESC",
