  "question": "Which buildings near campus have the most open issues?",
  "text": "Buildings near campus with the most open issues include:\n- 681 N HENRY ST with 8 open issues\n- 2432 LANGDON ST with 6 open issues\n- 1234 DEMO ST with 6 open issues\n- 1207 VAN BUREN ST with 6 open issues\n- 763 BROOKS ST with 5 open issues",
  "sql": "WITH campus_buildings AS (\n  SELECT \n    p.address_norm,\n    COUNT(r.report_id) AS open_issues\n  FROM `fixit`.`gold`.`properties` p\n  JOIN `fixit`.`gold`.`reports` r ON p.property_id = r.property_id\n  WHERE p.neighborhood IN ('Langdon', 'Mifflin', 'Regent', 'Greenbush')\n    AND r.status IN ('open','escalated')\n    AND p.address_norm IS NOT NULL\n  GROUP BY p.address_norm\n)\nSELECT address_norm, open_issues, RANK() OVER (ORDER BY open_issues DESC) AS rank\nFROM campus_buildings\nWHERE open_issues IS NOT NULL\nORDER BY rank;",
