{
  "question": "Which buildings near campus have the most open issues?",
  "text": "Buildings near campus with the most open issues include:\n- 681 N HENRY ST in Langdon with 8 open issues\n- 1207 VAN BUREN ST in Regent with 7 open issues\n- 1234 DEMO ST in Langdon with 6 open issues\n- 2432 LANGDON ST in Langdon with 6 open issues\n- 784 N BASSETT ST in Mifflin with 5 open issues",
  "sql": "WITH campus_buildings AS (\n  SELECT properties.property_id, properties.address_norm, properties.neighborhood\n  FROM `fixit`.`gold`.`properties` properties\n  WHERE properties.neighborhood IN ('Langdon', 'Mifflin', 'Regent', 'Greenbush')\n    AND properties.address_norm IS NOT NULL\n    AND properties.neighborhood IS NOT NULL\n)\nSELECT campus_buildings.property_id, campus_buildings.address_norm, campus_buildings.neighborhood, COUNT(reports.report_id) AS open_issues,\n       RANK() OVER (ORDER BY COUNT(reports.report_id) DESC) AS rank\nFROM campus_buildings\nJOIN `fixit`.`gold`.`reports` reports ON campus_buildings.property_id = reports.property_id\nWHERE reports.status IN ('open','escalated')\nGROUP BY campus_buildings.property_id, campus_buildings.address_norm, campus_buildings.neighborhood\nHAVING COUNT(reports.report_id) IS NOT NULL\nORDER BY open_issues DESC",
